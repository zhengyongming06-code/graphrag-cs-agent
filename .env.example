# NovaDesk GraphRAG CS Agent
# Copy to .env and fill in values

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_demo_password

# LLM (OpenAI-compatible: OpenAI / DeepSeek / Moonshot / Ollama gateway)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings (same provider or separate)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Local fallback when no API key: hash-based demo embeddings (for offline Neo4j demos)
EMBEDDING_DIM=384
USE_LOCAL_EMBEDDINGS=true

# App
APP_HOST=0.0.0.0
APP_PORT=8000
# 修改后，入库/评测接口需要请求头 X-Admin-Token
APP_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
