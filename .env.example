# 知识库客服
# Copy to .env

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_demo_password

# LLM（OpenAI 兼容：DeepSeek / OpenAI / 本地网关）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embeddings (same provider or separate)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Local fallback when no API key: hash-based demo embeddings (for offline Neo4j demos)
EMBEDDING_DIM=384
USE_LOCAL_EMBEDDINGS=true

# App
APP_HOST=0.0.0.0
APP_PORT=8000
# 写接口 / 会话导出必须带 X-Service-Token 或 X-Admin-Token，与此值一致。空请求不再放行。
APP_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8088,http://127.0.0.1:8088

# Agent 证据门控（规则分，不是 NLI）
CONFIDENCE_THRESHOLD=0.28
MAX_HISTORY_TURNS=6
USE_LLM_ROUTER=false

# Docker Compose 里的 api 服务会覆盖为 bolt://neo4j:7687
# 本机直接跑 uvicorn 时请用上面的 localhost:7688
